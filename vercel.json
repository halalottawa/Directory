{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{dist/template.spa.html,dist/index.html,firebase-applet-config.json,redirects.json,public/*.txt,public/*.xml}"
    }
  },
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/fonts/(.*)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/uploads/(.*)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "p" }],
      "dest": "/api/index"
    },
    {
      "src": "^/(?:.*\\/)?feed/?$",
      "dest": "/api/index"
    },
    {
      "src": "^/comments/feed/?$",
      "dest": "/api/index"
    },
    {
      "src": "^/listing-tag(?:/.*)?$",
      "dest": "/api/index"
    },
    {
      "src": "^/wp-.*$",
      "dest": "/api/index"
    },
    {
      "src": "^/xmlrpc\\.php$",
      "dest": "/api/index"
    },
    {
      "src": "^/app-ads\\.txt/?$",
      "dest": "/api/index"
    },
    {
      "src": "^/(sitemap\\.xml|sitemap-news\\.xml)$",
      "headers": { "x-vercel-enable-rewrite-caching": "1" },
      "dest": "/api/index"
    },
    {
      "src": "^/(listings|restaurants|mosques|organizations|grocery|clothing|schools|butchers)$",
      "headers": { "x-vercel-enable-rewrite-caching": "1" },
      "dest": "/api/index"
    },
    {
      "src": "^/restaurants/(.*)$",
      "headers": { "x-vercel-enable-rewrite-caching": "1" },
      "dest": "/api/index"
    },
    {
      "src": "^/(?!api/)(.+)/$",
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "headers": { "x-vercel-enable-rewrite-caching": "1" },
      "dest": "/api/index"
    }
  ]
}
