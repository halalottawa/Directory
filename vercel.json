{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/listings",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/qibla", "destination": "/tools/qibla", "permanent": true },
    { "source": "/authors/:slug", "destination": "/author/youssef-agrebi", "permanent": true },
    { "source": "/events", "destination": "/", "permanent": true },
    { "source": "/events/:slug*", "destination": "/", "permanent": true },
    { "source": "/jobs", "destination": "/", "permanent": true },
    { "source": "/jobs/:slug*", "destination": "/", "permanent": true },
    { "source": "/islamic%20schools/:slug", "destination": "/schools/:slug", "permanent": true },
    { "source": "/islamic schools/:slug", "destination": "/schools/:slug", "permanent": true },
    { "source": "/restaurants/caf%C3%A9s", "destination": "/restaurants/cafes", "permanent": true },
    { "source": "/restaurants/cafés", "destination": "/restaurants/cafes", "permanent": true },
    { "source": "/:sub(bakery|pizza|burgers|cafes|seafood|steakhouse|shawarma|poutine|brunch|breakfast|pho|ramen|fried-chicken|buffet|tacos|turkish|middle-eastern|moroccan|lebanese|syrian|pakistani|afghani|indian|persian|chinese|mediterranean|thai|korean|italian|bangladeshi|mexican|ethiopian)", "destination": "/restaurants/:sub", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://ais-pre-o3grau7ukgun6nvnjrynhh-118138859761.us-east5.run.app/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://ais-pre-o3grau7ukgun6nvnjrynhh-118138859761.us-east5.run.app/uploads/$1" },
    { "source": "/(.*)", "destination": "https://ais-pre-o3grau7ukgun6nvnjrynhh-118138859761.us-east5.run.app/$1" }
  ]
}
